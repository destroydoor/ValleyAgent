<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net6.0</TargetFramework>
        <LangVersion>11.0</LangVersion>
        <Version>2.0.0</Version>
        <Nullable>enable</Nullable>
        <OutputType>Library</OutputType>
        <RootNamespace>ValleyAgent</RootNamespace>
        <AssemblyName>ValleyAgent</AssemblyName>
        <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
        <EnableHarmony>true</EnableHarmony>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="Pathoschild.Stardew.ModBuildConfig" Version="4.4.0"/>
    </ItemGroup>
    <ItemGroup>
        <ProjectReference Include="..\ValleyAgent.Abstractions\ValleyAgent.Abstractions.csproj"/>
    </ItemGroup>
    <ItemGroup>
        <InternalsVisibleTo Include="ValleyAgent.UnitTests"/>
        <InternalsVisibleTo Include="ValleyAgent.TestMod"/>
    </ItemGroup>
    <ItemGroup>
        <None Update="manifest.json">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
        <None Update="RAG\*.json">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
        <EmbeddedResource Include="i18n\*.json"/>
        <None Update="i18n\*.json">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
        <None Update="assets\*.json">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
        <None Update="Data\*.json">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
        <None Update="npc-configs\*.json">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
    </ItemGroup>
</Project>
