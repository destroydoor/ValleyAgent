# ValleyTalk — CA 规则精简配置
# 原则：仅保留真正有功能影响的规则为 warning，其余全部关闭
# 游戏mod场景：框架回调参数不可能为null、catch(Exception)是合理的防御性编程

root = true

[*.cs]
# ============================================================
# 保留为 warning 的规则（真正有功能影响）
# ============================================================

# CA1063: Dispose 模式 — 资源泄漏风险
dotnet_diagnostic.CA1063.severity = warning
# CA1816: GC.SuppressFinalize — 与 Dispose 模式配套
dotnet_diagnostic.CA1816.severity = warning
# CA1823: 未使用字段 — 死代码
dotnet_diagnostic.CA1823.severity = warning
# CA2000: 丢失 IDisposable 对象 — 资源泄漏
dotnet_diagnostic.CA2000.severity = warning
# CA2200: 重新抛出异常丢失堆栈 — 调试困难
dotnet_diagnostic.CA2200.severity = warning
# CA2201: 不抛出保留异常类型 — 运行时行为异常
dotnet_diagnostic.CA2201.severity = warning
# CA2211: 非常量静态字段 — 多线程/多实例共享状态
dotnet_diagnostic.CA2211.severity = warning
# CA2213: 未释放的字段 — 资源泄漏
dotnet_diagnostic.CA2213.severity = warning
# CA2241: 格式化参数不匹配 — 运行时 FormatException
dotnet_diagnostic.CA2241.severity = warning

# ============================================================
# 显式关闭：实际触发但属于噪音的规则
# ============================================================

# CA1062: 参数 null 验证 — SMAPI 框架回调参数不可能为 null，关闭避免噪音
dotnet_diagnostic.CA1062.severity = none
# CA1031: 捕获过于宽泛的异常 — 游戏 mod 命令处理器需要 catch(Exception) 防止游戏崩溃，关闭
dotnet_diagnostic.CA1031.severity = none
# CA1822: 可标记为 static — 修复需改变方法签名和调用方，收益低，关闭
dotnet_diagnostic.CA1822.severity = none
# CA1861: 常量数组参数 — 每次调用分配新数组，改为 static readonly
dotnet_diagnostic.CA1861.severity = warning

# ============================================================
# 显式关闭：设计/命名/全球化/安全/性能等不适用规则
# ============================================================

# CA10xx: 设计规则 — 纯 API 设计风格，游戏 mod 不需要
dotnet_diagnostic.CA1000.severity = none
