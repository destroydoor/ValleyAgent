# Local secrets template — copy to secrets.local.ps1 and fill in real keys.
# secrets.local.ps1 is gitignored; NEVER commit real keys.
#
# Sourced by scripts/test/test-game.ps1, scripts/build/deploy.ps1 and
# scripts/test/run-minimax-test.ps1 to set VALLEY_LLM_* env vars for the
# TS Agent Server (valley-ai-server.exe).
#
# The C# ServerProcessManager passes these as CLI args (--llm-api-key /
# --llm-model / --llm-base-url / --llm-provider) to valley-ai-server.exe.
# The TS server also reads LLM_API_KEY / LLM_MODEL / LLM_BASE_URL /
# LLM_PROVIDER env vars as fallbacks (cli.ts).
#
# Usage from PowerShell:
#   . "$PSScriptRoot\..\secrets.local.ps1"   # adjust path as needed
#
# All vars are optional: scripts only set defaults if not already in env.

# ── MiniMax Cloud API (Token Plan) ────────────────────────────────────
$env:VALLEY_LLM_PROVIDER = "minimax"
$env:VALLEY_LLM_BASE_URL  = "https://api.minimax.chat/v1"
$env:VALLEY_LLM_API_KEY   = "<YOUR_MINIMAX_KEY>"
$env:VALLEY_LLM_MODEL     = "minimax-M3"
